<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>{{ title }} — {{ site.title }}</title>
  <script>
    (function() {
      var t = localStorage.getItem('cairns-theme');
      if (t) document.documentElement.setAttribute('data-theme', t);
      else if (window.matchMedia('(prefers-color-scheme: light)').matches)
        document.documentElement.setAttribute('data-theme', 'light');
    })();
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet"/>
  <link rel="stylesheet" href="{{ '/css/base.css' | url }}"/>
  <link rel="stylesheet" href="{{ '/css/article.css' | url }}"/>
  <link rel="stylesheet" href="{{ '/css/syntax.css' | url }}"/>
  <link rel="stylesheet" href="{{ '/css/search.css' | url }}"/>
  {% if site.annotations %}<link rel="stylesheet" href="{{ '/css/annotate.css' | url }}"/>{% endif %}
  <link rel="stylesheet" href="{{ pagefind.assetPath | url }}pagefind-ui.css"/>
</head>
<body{% if site.annotations %} data-annotate-repo="{{ site.annotations.repo }}" data-annotate-url="{{ site.url }}"{% endif %}>
  {% include "partials/header.njk" %}

  <div class="progress-bar" id="progress"></div>

  <div class="page-grid">
    <!-- Left Sidebar TOC -->
    <nav class="toc-sidebar" aria-label="Table of contents">
      <div class="toc-sidebar__label">Contents</div>
      <ul class="toc-sidebar__list" id="toc-list"></ul>
    </nav>

    <!-- Main Article Column -->
    <article class="article-content">
      <header class="article-header">
        <div class="article-header__eyebrow">
          <span>Cairn &middot; {{ date | dateFormat }}</span>
          {% if trail %}
          <a href="{{ ('/trails/' + (trail | slugify) + '/') | url }}" class="article-header__trail-link"><span class="article-header__trail-link__arrow">&uarr;</span>{{ trail }}</a>
          {% endif %}
        </div>
        <h1 class="article-header__title">{{ title }}</h1>
        <p class="article-header__subtitle">{{ subtitle }} &middot;
          <span class="reading-time" data-reading-time="full">~{{ duration }} min read</span>
          <span class="reading-time" data-reading-time="tldr" hidden>~<span data-tldr-min>–</span> min read</span>
          &middot; Suggested by {{ submitter }}
          {% if audience %}{% for aud in audience %}<span class="badge badge--audience">{{ aud }}</span>{% endfor %}{% endif %}
        </p>
        {% if lead %}
        <p class="article-header__lead">{{ lead | safe }}</p>
        {% endif %}
        <div class="view-toggle" hidden role="group" aria-label="Article view" data-view-toggle>
          <button type="button" class="view-toggle__btn" data-view-target="full" aria-pressed="true">Full <span class="view-toggle__time">~{{ duration }} min</span></button>
          <button type="button" class="view-toggle__btn" data-view-target="tldr" aria-pressed="false">TL;DR <span class="view-toggle__time" data-tldr-time>~– min</span></button>
        </div>
      </header>

      {% if prerequisites %}
      <div class="prereq-callout">
        <span class="prereq-callout__label">Before reading this</span>
        <ul>
          {% for slug in prerequisites %}
          {% set prereq = collections.articles | findBySlug(slug) %}
          {% if prereq %}
          <li><a href="{{ prereq.url | url }}">{{ prereq.data.title }}</a></li>
          {% endif %}
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      <div class="article-body" data-animate data-view="full" data-pagefind-body
           data-pagefind-meta="title:{{ title }}"
           data-pagefind-filter="tag[data-tag]">
        {% for tag in tags %}{% if tag != "articles" %}<span data-tag data-pagefind-filter="tag" hidden>{{ tag }}</span>{% endif %}{% endfor %}
        {{ content | safe }}
      </div>

      <div class="tldr-banner" hidden data-tldr-banner>
        You're reading the TL;DR. <a href="?view=full" data-switch-to="full">Read the full version &rarr;</a>
      </div>

      {% if trail %}
      {% set trailArticles = collections.trails[trail] %}
      {% if trailArticles %}
      <nav class="trail-nav" aria-label="Trail navigation">
        <div class="trail-nav__header">
          <span class="label label--accent">Trail: <a href="{{ ('/trails/' + (trail | slugify) + '/') | url }}" class="trail-nav__home-link">{{ trail }}</a></span>
          <span class="trail-nav__position">Part {{ trailOrder }} of {{ trailArticles | length }}</span>
        </div>
        <div class="trail-nav__links">
          {% set prev = null %}
          {% set next = null %}
          {% for item in trailArticles %}
            {% if item.data.trailOrder == trailOrder - 1 %}{% set prev = item %}{% endif %}
            {% if item.data.trailOrder == trailOrder + 1 %}{% set next = item %}{% endif %}
          {% endfor %}
          {% if prev %}
          <a href="{{ prev.url | url }}" class="trail-nav__link trail-nav__prev">&larr; {{ prev.data.title }}</a>
          {% else %}
          <span class="trail-nav__link trail-nav__disabled">&larr; Start of trail</span>
          {% endif %}
          {% if next %}
          <a href="{{ next.url | url }}" class="trail-nav__link trail-nav__next">{{ next.data.title }} &rarr;</a>
          {% else %}
          <span class="trail-nav__link trail-nav__disabled">End of trail &rarr;</span>
          {% endif %}
        </div>
      </nav>
      {% endif %}
      {% endif %}

      {% if related %}
      <div class="related-cairns">
        <span class="label">Related Cairns</span>
        <ul>
          {% for slug in related %}
          {% set rel = collections.articles | findBySlug(slug) %}
          {% if rel %}
          <li><a href="{{ rel.url | url }}">{{ rel.data.title }}</a> — {{ rel.data.subtitle }}</li>
          {% endif %}
          {% endfor %}
        </ul>
      </div>
      {% endif %}

      <div class="colophon">
        <p>Generated by Cairns &middot; Agent-powered with Claude</p>
        <p><a href="{{ '/trailhead/' | url }}">&larr; Back to Trailhead</a></p>
      </div>
    </article>
  </div>

  {% include "partials/footer.njk" %}

  <script src="{{ pagefind.assetPath | url }}pagefind-ui.js"></script>
  <script>
    // Theme toggle
    document.getElementById('theme-toggle').addEventListener('click', function() {
      var html = document.documentElement;
      var current = html.getAttribute('data-theme') || 'dark';
      var next = current === 'dark' ? 'light' : 'dark';
      html.setAttribute('data-theme', next);
      localStorage.setItem('cairns-theme', next);
    });

    // Header search toggle
    (function() {
      var btn = document.getElementById('search-toggle');
      var overlay = document.getElementById('search-overlay');
      if (!btn || !overlay) return;
      new PagefindUI({
        element: "#search-overlay-inner",
        showSubResults: true,
        showImages: false,
        bundlePath: "{{ pagefind.assetPath | url }}"
      });
      btn.addEventListener('click', function(e) {
        e.stopPropagation();
        var open = overlay.classList.toggle('search-overlay--open');
        if (open) {
          var input = overlay.querySelector('.pagefind-ui__search-input');
          if (input) input.focus();
        }
      });
      document.addEventListener('click', function(e) {
        if (!overlay.contains(e.target) && e.target !== btn) {
          overlay.classList.remove('search-overlay--open');
        }
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') overlay.classList.remove('search-overlay--open');
      });
    })();

    // Scroll progress bar
    window.addEventListener('scroll', () => {
      const h = document.documentElement.scrollHeight - window.innerHeight;
      if (h > 0) document.getElementById('progress').style.width = (window.scrollY / h) * 100 + '%';
    });

    // Wrap h2-delimited content into <section> elements within a container so the
    // Full and TL;DR views each get clean section grouping for TOC and animation.
    function wrapH2Sections(container) {
      if (!container) return;
      const children = Array.from(container.childNodes);
      const fragment = document.createDocumentFragment();
      let currentSection = null;
      children.forEach(node => {
        if (node.nodeType === 1 && node.tagName === 'H2') {
          currentSection = document.createElement('section');
          currentSection.id = node.id || '';
          fragment.appendChild(currentSection);
          currentSection.appendChild(node);
        } else if (currentSection) {
          currentSection.appendChild(node);
        } else {
          fragment.appendChild(node);
        }
      });
      container.innerHTML = '';
      container.appendChild(fragment);
    }

    const body = document.querySelector('.article-body');
    const tldrBlock = body && body.querySelector('.cairn-tldr');

    // If a TL;DR exists, lift it out so it's a sibling of (not nested in) the Full
    // sections we're about to create. Both halves then get their own section list.
    let tldrContent = null;
    if (tldrBlock) {
      // Reclaim canonical anchor IDs for the Full content. markdown-it-anchor
      // numbers duplicate slugs in source order — TL;DR (top of source) takes
      // the clean IDs and Full sections get "-1" suffixes. Swap so external
      // links to the canonical slug land in Full (the default view), and the
      // TL;DR sections get distinct "-tldr" IDs for their own TOC.
      const tldrIds = new Set();
      tldrBlock.querySelectorAll('[id]').forEach(el => tldrIds.add(el.id));
      body.querySelectorAll('[id]').forEach(el => {
        if (tldrBlock.contains(el)) return;
        const m = el.id.match(/^(.*?)-(\d+)$/);
        if (m && tldrIds.has(m[1])) el.id = m[1];
      });
      tldrBlock.querySelectorAll('[id]').forEach(el => { el.id = el.id + '-tldr'; });

      tldrContent = document.createElement('div');
      tldrContent.className = 'cairn-tldr cairn-tldr--lifted';
      tldrContent.dataset.pagefindIgnore = 'true';
      while (tldrBlock.firstChild) tldrContent.appendChild(tldrBlock.firstChild);
      tldrBlock.remove();
    }

    wrapH2Sections(body);

    if (tldrContent) {
      wrapH2Sections(tldrContent);
      body.insertBefore(tldrContent, body.firstChild);
    }

    // Auto-generate TOC from sections of the active view
    const tocList = document.getElementById('toc-list');
    function rebuildToc(view) {
      tocList.innerHTML = '';
      const scope = view === 'tldr' && tldrContent ? tldrContent : body;
      const sects = scope.querySelectorAll(':scope > section[id]');
      sects.forEach(sec => {
        const h = sec.querySelector('h2');
        if (!h) return;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = '#' + sec.id;
        a.textContent = h.textContent;
        a.dataset.section = sec.id;
        li.appendChild(a);
        tocList.appendChild(li);
      });
      attachTocObserver(sects);
      return sects;
    }

    let tocObserver = null;
    function attachTocObserver(sects) {
      if (tocObserver) tocObserver.disconnect();
      const tocLinks = tocList.querySelectorAll('a');
      tocObserver = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            tocLinks.forEach(l => l.classList.remove('active'));
            const match = tocList.querySelector('a[data-section="' + entry.target.id + '"]');
            if (match) match.classList.add('active');
          }
        });
      }, { rootMargin: '-10% 0px -80% 0px', threshold: 0 });
      sects.forEach(s => tocObserver.observe(s));
    }

    // --- Full / TL;DR view machinery ---
    const viewToggle = document.querySelector('[data-view-toggle]');
    const tldrBanner = document.querySelector('[data-tldr-banner]');
    const fullReadingTime = document.querySelector('[data-reading-time="full"]');
    const tldrReadingTime = document.querySelector('[data-reading-time="tldr"]');
    const tldrTimeChips = document.querySelectorAll('[data-tldr-time], [data-tldr-min]');

    function computeReadingMinutes(el) {
      if (!el) return 0;
      // Exclude trailing reference / prompt / summary blocks (navigational,
      // not part of the read), the lifted TL;DR (when computing Full), and
      // any inline scripts/styles that might be in the cloned tree.
      const clone = el.cloneNode(true);
      clone.querySelectorAll('.cairn-tldr--lifted, .references, .discussion-prompts, .summary-list, script, style').forEach(n => n.remove());
      const text = clone.textContent || '';
      const words = text.trim().split(/\s+/).filter(Boolean).length;
      return Math.max(1, Math.round(words / 220));
    }

    let sectionObserver = null;
    function attachSectionAnimation(sects) {
      if (sectionObserver) sectionObserver.disconnect();
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        sectionObserver = new IntersectionObserver(entries => {
          entries.forEach(e => { if (e.isIntersecting) e.target.classList.add('visible'); });
        }, { threshold: 0.06 });
        sects.forEach(s => sectionObserver.observe(s));
      } else {
        sects.forEach(s => s.classList.add('visible'));
      }
    }

    function applyView(view) {
      const v = view === 'tldr' && tldrContent ? 'tldr' : 'full';
      body.setAttribute('data-view', v);
      if (viewToggle) {
        viewToggle.querySelectorAll('.view-toggle__btn').forEach(btn => {
          btn.setAttribute('aria-pressed', btn.dataset.viewTarget === v ? 'true' : 'false');
        });
      }
      if (fullReadingTime) fullReadingTime.hidden = v !== 'full';
      if (tldrReadingTime) tldrReadingTime.hidden = v !== 'tldr';
      if (tldrBanner) tldrBanner.hidden = v !== 'tldr';
      const sects = rebuildToc(v);
      attachSectionAnimation(sects);
      try { localStorage.setItem('cairns-view', v); } catch (e) {}
      const url = new URL(window.location.href);
      if (v === 'tldr') url.searchParams.set('view', 'tldr');
      else url.searchParams.delete('view');
      window.history.replaceState({}, '', url.toString());
    }

    // Compute and display the Full view's reading time client-side using
    // the same heuristic as TL;DR. The frontmatter `duration` is the initial
    // server-rendered value; this overrides it so the displayed time excludes
    // the trailing references / prompts / summary blocks (interesting but
    // navigational, not part of the read).
    const fullMin = computeReadingMinutes(body);
    if (fullReadingTime) fullReadingTime.textContent = '~' + fullMin + ' min read';
    const fullToggleTime = viewToggle && viewToggle.querySelector('[data-view-target="full"] .view-toggle__time');
    if (fullToggleTime) fullToggleTime.textContent = '~' + fullMin + ' min';

    if (tldrContent) {
      // Compute and display TL;DR reading time
      const tldrMin = computeReadingMinutes(tldrContent);
      tldrTimeChips.forEach(el => {
        if (el.hasAttribute('data-tldr-time')) el.textContent = '~' + tldrMin + ' min';
        if (el.hasAttribute('data-tldr-min')) el.textContent = tldrMin;
      });
      if (viewToggle) viewToggle.hidden = false;

      // Wire toggle clicks
      viewToggle.querySelectorAll('.view-toggle__btn').forEach(btn => {
        btn.addEventListener('click', () => applyView(btn.dataset.viewTarget));
      });

      // Banner switch link
      const bannerLink = tldrBanner && tldrBanner.querySelector('[data-switch-to]');
      if (bannerLink) {
        bannerLink.addEventListener('click', e => {
          e.preventDefault();
          applyView('full');
        });
      }

      // Resolve initial view: URL param > localStorage > 'full'
      const urlView = new URL(window.location.href).searchParams.get('view');
      let initial = 'full';
      if (urlView === 'tldr' || urlView === 'full') initial = urlView;
      else {
        try {
          const stored = localStorage.getItem('cairns-view');
          if (stored === 'tldr' || stored === 'full') initial = stored;
        } catch (e) {}
      }
      applyView(initial);
    } else {
      // No TL;DR: just build TOC and animations from the Full body
      const sects = rebuildToc('full');
      attachSectionAnimation(sects);
    }
  </script>
  <noscript><style>.article-body[data-animate] section{opacity:1;transform:none;}</style></noscript>
  <!-- Mermaid: client-side diagram rendering with theme toggle support -->
  <script type="module">
    import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

    const darkVars = {
      darkMode: true, background: '#14141f',
      primaryColor: '#2a2a4a', primaryTextColor: '#e8e8f0',
      primaryBorderColor: '#7c5cfc', lineColor: '#c0c0cc',
      secondaryColor: '#1e1e30', tertiaryColor: '#0c0c14',
      noteBkgColor: '#2a2a4a', noteTextColor: '#e8e8f0',
      signalTextColor: '#e8e8f0', labelTextColor: '#e8e8f0',
      loopTextColor: '#e8e8f0', messageFontColor: '#e8e8f0',
      actorTextColor: '#e8e8f0', actorBkg: '#2a2a4a', actorBorder: '#7c5cfc',
      activationBorderColor: '#7c5cfc', activationBkgColor: '#1e1e30',
      sequenceNumberColor: '#e8e8f0',
      labelBoxBkgColor: '#2a2a4a', labelBoxBorderColor: '#7c5cfc',
      edgeLabelBackground: '#1e1e30',
      fontFamily: 'Inter, system-ui, sans-serif'
    };

    const lightVars = {
      darkMode: false, background: '#f5f5f0',
      primaryColor: '#ddd8d0', primaryTextColor: '#1a1a2e',
      primaryBorderColor: '#5a3fd4', lineColor: '#555',
      secondaryColor: '#e8e4dc', tertiaryColor: '#f0ece6',
      noteBkgColor: '#ddd8d0', noteTextColor: '#1a1a2e',
      signalTextColor: '#1a1a2e', labelTextColor: '#1a1a2e',
      loopTextColor: '#1a1a2e', messageFontColor: '#1a1a2e',
      actorTextColor: '#1a1a2e', actorBkg: '#ddd8d0', actorBorder: '#5a3fd4',
      activationBorderColor: '#5a3fd4', activationBkgColor: '#e8e4dc',
      sequenceNumberColor: '#1a1a2e',
      labelBoxBkgColor: '#ddd8d0', labelBoxBorderColor: '#5a3fd4',
      edgeLabelBackground: '#f5f5f0',
      fontFamily: 'Inter, system-ui, sans-serif'
    };

    // Store original diagram source for re-rendering on theme toggle
    const mermaidBlocks = document.querySelectorAll('pre.mermaid');
    const originals = Array.from(mermaidBlocks).map(el => el.textContent);

    function getThemeConfig() {
      const isDark = document.documentElement.getAttribute('data-theme') !== 'light';
      return { startOnLoad: false, theme: isDark ? 'dark' : 'default', themeVariables: isDark ? darkVars : lightVars };
    }

    async function renderMermaid() {
      mermaid.initialize(getThemeConfig());
      mermaidBlocks.forEach((el, i) => {
        el.removeAttribute('data-processed');
        el.innerHTML = originals[i];
      });
      await mermaid.run({ nodes: mermaidBlocks });
    }

    // Initial render
    await renderMermaid();

    // Re-render on theme toggle
    document.getElementById('theme-toggle').addEventListener('click', () => {
      // Small delay to let the data-theme attribute update first
      setTimeout(renderMermaid, 50);
    });
  </script>
  {% if site.annotations %}<script>{% include "js/annotate.js" %}</script>{% endif %}
</body>
</html>
