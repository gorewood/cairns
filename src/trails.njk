---
layout: layouts/base.njk
title: Trails
pageCss: index.css
permalink: /trails/
---
<div class="layout" data-pagefind-ignore="all">

  <!-- Left Sidebar -->
  <aside class="sidebar-left">
    <p class="label">Trails</p>
    <p class="sublabel">Multi-Part Series</p>
    <ul class="cat-list">
      {% for t in collections.trailList %}
      <li><a href="{{ ('/trails/' + t.slug + '/') | url }}">{{ t.name }}</a></li>
      {% endfor %}
    </ul>
  </aside>

  <!-- Main Content -->
  <main class="main-content">
    <p class="label label--accent">Trails</p>
    <h1 style="font-size:1.8rem;font-weight:700;color:var(--text-bright);margin-bottom:0.4rem;">Knowledge Trails</h1>
    <p style="font-size:0.88rem;color:var(--text-muted);margin-bottom:2rem;">Multi-part series that build understanding step by step. Pick a trail to see its arc, or jump straight to the first cairn.</p>

    {% if collections.trailList | length %}
    <div class="trail-directory">
      {% for trail in collections.trailList %}
      <a href="{{ ('/trails/' + trail.slug + '/') | url }}" class="trail-directory__card">
        <div class="trail-directory__title">{{ trail.name }}</div>
        <div class="trail-directory__meta">
          {{ trail.parts }} parts &middot; ~{{ trail.totalDuration }} min &middot; updated {{ trail.latestDateISO | dateFormat }}
        </div>
        {% if trail.description %}
        <p class="trail-directory__desc">{{ trail.description }}</p>
        {% endif %}
        <div class="trail-directory__cta">View trail &rarr;</div>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <p style="color:var(--text-muted);font-style:italic;">No trails yet. Check back soon.</p>
    {% endif %}

  </main>

  <!-- Right Sidebar -->
  <aside class="sidebar-right">
    <p class="label">Statistics</p>
    <dl class="meta-table">
      <dt>Trails</dt>
      <dd>{{ collections.trailList | length }}</dd>
      <dt>Total Cairns</dt>
      <dd>{{ collections.articles | length }}</dd>
    </dl>
  </aside>

</div>
