{
  "name": "cairns",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-powered knowledge trail system",
  "scripts": {
    "build": "npx @11ty/eleventy && npx pagefind --site _site && node scripts/version-pagefind-assets.js",
